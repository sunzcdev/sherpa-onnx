 {
  "title": "Unit 1 Helping at home · 主句型",
  "author": "PEP四上",
  "dynasty": "",
  "text": "What's your mother's job? She's a nurse. What does your father do? He's a doctor. Can you help mom do some chores? Sure. I can sweep the floor. Let's clean the room together. OK, let's start!",
  "category": "english-4a",
  "lang": "en",
  "grade": "4a",
  "subject": "yingyu"
 },
 {
  "title": "Unit 2 My friends · 主句型",
  "author": "PEP四上",
  "dynasty": "",
  "text": "Who is your best friend? He is Zhang Peng. What's he like? He's tall and strong. He has short hair and big eyes. He's very friendly. My friend is good at English. We often play together.",
  "category": "english-4a",
  "lang": "en",
  "grade": "4a",
  "subject": "yingyu"
 },
 {
  "title": "Unit 3 Places we live in · 主句型",
  "author": "PEP四上",
  "dynasty": "",
  "text": "Where is the post office? It's next to the hospital. Is there a library near here? Yes, there is. Let's go to the park. Great! How do we get there? My home is on the fifth floor. There is a big garden.",
  "category": "english-4a",
  "lang": "en",
  "grade": "4a",
  "subject": "yingyu"
 },
 {
  "title": "Unit 4 Helping in the community · 主句型",
  "author": "PEP四上",
  "dynasty": "",
  "text": "What can we do for the community? We can visit the old people. Can I help you? Yes, please clean the table. The phone is broken. Who can fix it? Let's ask the worker. Here is the food for the elephant. Thank you!",
  "category": "english-4a",
  "lang": "en",
  "grade": "4a",
  "subject": "yingyu"
 },
 {
  "title": "Unit 5 The weather and us · 主句型",
  "author": "PEP四上",
  "dynasty": "",
  "text": "What's the weather like today? It's sunny and warm. Can I go outside? No, it's raining. You can't. What's the temperature? It's 20 degrees. Let's fly kites. The wind is just right for that!",
  "category": "english-4a",
  "lang": "en",
  "grade": "4a",
  "subject": "yingyu"
 },
 {
  "title": "Unit 6 Changing for the seasons · 主句型",
  "author": "PEP四上",
  "dynasty": "",
  "text": "What's your favourite season? I like spring best. What do you do in summer? I go swimming with friends. In autumn, leaves turn yellow and fall down. It snows in winter. We can make a snowman!",
  "category": "english-4a",
  "lang": "en",
  "grade": "4a",
  "subject": "yingyu"
 }
]