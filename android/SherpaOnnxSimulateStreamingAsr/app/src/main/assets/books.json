[
 {
  "title": "古诗三首·暮江吟",
  "author": "白居易",
  "dynasty": "唐",
  "text": "一道残阳铺水中，半江瑟瑟半江红。可怜九月初三夜，露似真珠月似弓。",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "古诗三首·题西林壁",
  "author": "苏轼",
  "dynasty": "宋",
  "text": "横看成岭侧成峰，远近高低各不同。不识庐山真面目，只缘身在此山中。",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "古诗三首·雪梅",
  "author": "卢梅坡",
  "dynasty": "宋",
  "text": "梅雪争春未肯降，骚人阁笔费评章。梅须逊雪三分白，雪却输梅一段香。",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "古诗三首·出塞",
  "author": "王昌龄",
  "dynasty": "唐",
  "text": "秦时明月汉时关，万里长征人未还。但使龙城飞将在，不教胡马度阴山。",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "古诗三首·凉州词",
  "author": "王翰",
  "dynasty": "唐",
  "text": "葡萄美酒夜光杯，欲饮琵琶马上催。醉卧沙场君莫笑，古来征战几人回？",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "古诗三首·夏日绝句",
  "author": "李清照",
  "dynasty": "宋",
  "text": "生当作人杰，死亦为鬼雄。至今思项羽，不肯过江东。",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "鹿柴·语文园地一",
  "author": "王维",
  "dynasty": "唐",
  "text": "空山不见人，但闻人语响。返景入深林，复照青苔上。",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "嫦娥·语文园地四",
  "author": "李商隐",
  "dynasty": "唐",
  "text": "云母屏风烛影深，长河渐落晓星沉。嫦娥应悔偷灵药，碧海青天夜夜心。",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "别董大·语文园地七",
  "author": "高适",
  "dynasty": "唐",
  "text": "千里黄云白日曛，北风吹雁雪纷纷。莫愁前路无知己，天下谁人不识君？",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "日积月累·园地二",
  "author": "先秦经典",
  "dynasty": "",
  "text": "好问则裕，自用则小。博学之，审问之，慎思之，明辨之，笃行之。智能之士，不学不成，不问不知。人非生而知之者，孰能无惑？",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "日积月累·园地三",
  "author": "气象谚语",
  "dynasty": "",
  "text": "立了秋，把扇丢。二八月，乱穿衣。夏雨少，秋霜早。八月里来雁门开，雁儿脚上带霜来。一场秋雨一场寒，十场秋雨要穿棉。八月暖，九月温，十月还有小阳春。",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "日积月累·园地六",
  "author": "常用八字成语",
  "dynasty": "",
  "text": "尺有所短，寸有所长。机不可失，时不再来。差之毫厘，谬以千里。病从口入，祸从口出。一言既出，驷马难追。比上不足，比下有余。",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "日积月累·园地八",
  "author": "描写人物成语",
  "dynasty": "",
  "text": "眉清目秀，亭亭玉立，明眸皓齿，文质彬彬，相貌堂堂，威风凛凛，膀大腰圆，浓眉大眼，白发苍苍，鹤发童颜，慈眉善目，步履蹒跚。",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "精卫填海",
  "author": "《山海经》",
  "dynasty": "",
  "text": "炎帝之少女，名曰女娃。女娃游于东海，溺而不返，故为精卫，常衔西山之木石，以堙于东海。",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
 {
  "title": "王戎不取道旁李",
  "author": "《世说新语》",
  "dynasty": "",
  "text": "王戎七岁，尝与诸小儿游。看道边李树多子折枝，诸儿竞走取之，唯戎不动。人问之，答曰：树在道边而多子，此必苦李。取之，信然。",
  "category": "yuwen-4a",
  "lang": "zh",
  "grade": "4a",
  "subject": "yuwen"
 },
